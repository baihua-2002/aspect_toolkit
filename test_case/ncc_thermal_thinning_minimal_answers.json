    "Material model.Simple model.Reference specific heat": 1250,
    "Material model.Simple model.Reference temperature": 273,
    "Material model.Simple model.Thermal conductivity": 5,
    "Material model.Simple model.Thermal expansion coefficient": 2.5e-05,
    "Material model.Simple model.Viscosity": 1e22,
    "Formulation.Formulation": "Boussinesq approximation",
    "Mesh refinement.Initial global refinement": 2,
    "Mesh refinement.Initial adaptive refinement": 0,
    "Mesh refinement.Time steps between mesh refinement": 0,
    "Postprocess.List of postprocessors": ["visualization", "velocity statistics", "temperature statistics"],
    "Postprocess.Visualization.Time between graphical output": 1000,
    "Postprocess.Visualization.Output format": "vtu",
    "Postprocess.Visualization.Number of grouped files": 1
  }
}
