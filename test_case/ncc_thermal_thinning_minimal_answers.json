{
  "benchmark_id": "NCC",
  "title": "North China Craton Thermal Convection Thinning",
  "reference": "Qiao, Guo, Shi (2013), Science China Earth Sciences, 43:642-652",
  "parameters": {
    "Dimension": 2,
    "Use years instead of seconds": true,
