{
  "benchmark_id": "3.5",
  "title": "Magmatic Shear Bands",
  "reference": "Spiegelman, Katz, Simpson (2007), Section 3.5, Eq. 3.13-3.17",
  "parameters": {
    "Dimension": 2,
    "Use years instead of seconds": false,
    "Start time": 0,
    "End time": 0.5,
    "Output directory": "output-mckenzie-3-5-shear-bands",
    "CFL number": 0.3,
    "Maximum time step": 0.05,
    "Nonlinear solver scheme": "single Advection, single Stokes",
    "Geometry model.Model name": "box",
    "Geometry model.Box.X extent": 2,
    "Geometry model.Box.Y extent": 1,
    "Geometry model.Box.X repetitions": 8,
    "Geometry model.Box.Y repetitions": 4,
    "Gravity model.Model name": "vertical",
    "Gravity model.Vertical.Magnitude": 0,
    "Boundary velocity model.Tangential velocity boundary indicators": ["bottom", "top"],
    "Boundary velocity model.Prescribed velocity boundary indicators": ["top: function", "bottom: function"],
    "Boundary temperature model.Fixed temperature boundary indicators": ["bottom", "top"],
    "Boundary temperature model.List of model names": ["box"],
    "Boundary temperature model.Box.Bottom temperature": 1,
    "Boundary temperature model.Box.Top temperature": 1,
    "Initial temperature model.Model name": "function",
    "Initial temperature model.Function.Variable names": "x,y",
    "Initial temperature model.Function.Function expression": "1 + 0.01*sin(2*pi*x)*sin(2*pi*y)",
    "Material model.Model name": "simple",
    "Material model.Simple model.Reference density": 1,
    "Material model.Simple model.Reference specific heat": 1,
    "Material model.Simple model.Reference temperature": 1,
    "Material model.Simple model.Thermal conductivity": 1,
    "Material model.Simple model.Thermal expansion coefficient": 0,
    "Material model.Simple model.Viscosity": 1,
    "Formulation.Formulation": "Boussinesq approximation",
    "Mesh refinement.Initial global refinement": 4,
    "Mesh refinement.Initial adaptive refinement": 2,
    "Mesh refinement.Time steps between mesh refinement": 5,
    "Postprocess.List of postprocessors": ["visualization", "velocity statistics"],
    "Postprocess.Visualization.Time between graphical output": 0.05,
    "Postprocess.Visualization.Output format": "vtu",
    "Postprocess.Visualization.Number of grouped files": 1
  }
}
