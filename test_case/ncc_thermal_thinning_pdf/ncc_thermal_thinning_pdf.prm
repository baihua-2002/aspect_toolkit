# Benchmark NCC-PDF: North China Craton Thermal Convection Thinning (reference std)
# Source: Qiao, Guo, Shi (2013), Science China Earth Sciences, 43:642-652
# Extracted end-to-end from test_case/数值模拟华北克拉通岩石圈热对流侵蚀减薄机制.pdf
# Main case: eta0 = 1.0e22 Pa s, bottom temperature = 1773 K (active end-member).
# 2D box 700km x 700km, Boussinesq thermal convection, free-slip, fixed T top/bottom.

set Dimension = 2
set Start time = 0
set End time = 1000
set Use years instead of seconds = true
set Output directory = output-ncc-thermal-thinning-pdf
set CFL number = 0.5
set Maximum time step = 100
set Nonlinear solver scheme = single Advection, single Stokes

subsection Geometry model
  set Model name = box

  subsection Box
    set X extent = 700000
    set Y extent = 700000
    set X repetitions = 8
    set Y repetitions = 8
  end
end

subsection Gravity model
  set Model name = vertical

  subsection Vertical
    set Magnitude = 10
  end
end

subsection Boundary velocity model
  set Tangential velocity boundary indicators = left, right, bottom, top
end

subsection Boundary temperature model
  set Fixed temperature boundary indicators = bottom, top
  set List of model names = box

  subsection Box
    set Bottom temperature = 1773
    set Top temperature = 273
  end
end

subsection Initial temperature model
  set Model name = function

  subsection Function
    set Variable names = x,y
    set Function expression = 1773 - 1500*y/700000
  end
end

subsection Material model
  set Model name = simple

  subsection Simple model
    set Reference density = 4000
    set Reference specific heat = 1250
    set Reference temperature = 273
    set Thermal conductivity = 5
    set Thermal expansion coefficient = 2.5e-05
    set Viscosity = 1e+22
  end
end

subsection Formulation
  set Formulation = Boussinesq approximation
end

subsection Mesh refinement
  set Initial global refinement = 2
  set Initial adaptive refinement = 0
  set Time steps between mesh refinement = 0
end

subsection Postprocess
  set List of postprocessors = visualization, velocity statistics, temperature statistics

  subsection Visualization
    set Time between graphical output = 1000
    set Output format = vtu
    set Number of grouped files = 1
  end
end
